(() => {
  const voices = speechSynthesis.getVoices();
  console.log('全部可用语音数量:', voices.length);

  // 1. 筛选常见男声或中文语音，方便你核对列表
  const candidates = voices.filter(v =>
    /^(?:zh|cmn)(?:[-_]|$)/i.test(v.lang) ||
    /(?:yunxi|云希|kangkang|康康|zhiwei|reed|eddy|alex|fred|daniel|tom|david|mark|george|guy|ryan)/i.test(v.name)
  );
  console.table(candidates.map((v, i) => ({
    idx: i,
    name: v.name,
    lang: v.lang,
    default: v.default
  })));

  // 2. 按男声关键词优先匹配（先中文男声，再常见男声）
  const maleVoice =
    voices.find(v => /^(?:zh|cmn)(?:[-_]|$)/i.test(v.lang) && /(?:yunxi|云希|kangkang|康康|zhiwei|reed|eddy)/i.test(v.name)) ||
    voices.find(v => /(?:yunxi|云希|kangkang|康康|zhiwei|reed|eddy|guy|ryan|daniel|alex|david|mark|george|tom)/i.test(v.name)) ||
    null;

  if (!maleVoice) {
    console.warn('没匹配到预设男声，建议直接从上面的表格里挑一个名字。');
    return;
  }

  console.log('选中的男声:', maleVoice.name, '|', maleVoice.lang);

  // 3. 试读一句中文（注意：部分浏览器/在线语音需要用户交互或等 voiceschanged）
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance('你好，我是伊森，现在测试男生语音是否能正常发声。');
  u.voice = maleVoice;
  u.lang = maleVoice.lang || 'zh-CN';
  u.rate = 1;
  u.pitch = 1;
  u.onstart = () => console.log('开始发声:', maleVoice.name);
  u.onerror = (e) => console.error('发声出错:', e);
  speechSynthesis.speak(u);
})();
